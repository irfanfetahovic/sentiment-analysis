# Environment Variables Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# Path Configuration (Optional - Auto-detected by default)
# =============================================================================
# Uncomment and set these if you need to override auto-detection

# Project root directory (auto-detected if not set)
# SENTIMENT_PROJECT_ROOT=/path/to/project

# Data directory (default: {PROJECT_ROOT}/data)
# SENTIMENT_DATA_DIR=data

# Model directory (default: {PROJECT_ROOT}/models)
# SENTIMENT_MODEL_DIR=models

# Config file (default: {PROJECT_ROOT}/config.yaml)
# SENTIMENT_CONFIG_FILE=config.yaml

# Logs directory (default: {PROJECT_ROOT}/logs)
# SENTIMENT_LOGS_DIR=logs

# =============================================================================
# Model Storage (Docker Deployment - Choose ONE option)
# =============================================================================
# Option 1: Download from S3
# MODEL_S3_URI=s3://your-bucket/models/distilbert_sentiment.tar.gz
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_DEFAULT_REGION=us-east-1

# Option 2: Download from HTTP URL (e.g., GitHub Releases)
# MODEL_URL=https://github.com/username/repo/releases/download/v1.0.0/distilbert_sentiment.tar.gz

# Option 3: Use local volume mount (no download needed)
# docker run -v ./models:/app/models ...

# =============================================================================
# Runtime Configuration
# =============================================================================
# Model configuration
MODEL_PATH=/app/models/distilbert_sentiment
MODEL_TYPE=transformer

# Device for model inference (cpu or cuda)
DEVICE=cpu

# API Configuration
HOST=0.0.0.0
PORT=5000
DEBUG=false

# Text processing limits
MAX_TEXT_LENGTH=512
MAX_BATCH_SIZE=32

# =============================================================================
# Logging
# =============================================================================
LOG_FILE=logs/app.log
LOG_LEVEL=INFO

# =============================================================================
# Security (REQUIRED for production)
# =============================================================================
# SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Optional: API authentication
# API_KEY=your-api-key-for-request-authentication

# Optional: Rate limiting
# RATE_LIMIT_PER_HOUR=100

# Note: All other configuration (paths, hyperparameters, etc.) 
# should be in config/config.yaml, not here.
